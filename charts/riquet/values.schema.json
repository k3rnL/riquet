{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "storage", "auth", "service"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "imagePullSecrets": {"type": "array"}, "nameOverride": {"type": "string"}, "fullnameOverride": {"type": "string"},
    "storage": {"type": "object", "additionalProperties": false, "required": ["backend", "pvc", "kafka"], "properties": {
      "backend": {"enum": ["pvc", "kafka"]},
      "pvc": {"type": "object", "additionalProperties": false, "required": ["size", "accessModes"], "properties": {"size": {"type": "string", "minLength": 1}, "storageClass": {"type": "string"}, "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
      "kafka": {"type": "object", "additionalProperties": false, "required": ["brokers", "topic", "transactionalId", "groupId", "replicationFactor", "autoCreateTopic", "maxReadyLag", "tls", "sasl"], "properties": {"brokers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "topic": {"type": "string", "minLength": 1}, "transactionalId": {"type": "string", "minLength": 1}, "groupId": {"type": "string", "minLength": 1}, "replicationFactor": {"type": "integer", "minimum": 1, "maximum": 32767}, "autoCreateTopic": {"type": "boolean"}, "maxReadyLag": {"type": "integer", "minimum": 0}, "tls": {"type": "object", "additionalProperties": false, "required": ["enabled", "secretName", "caKey", "certKey", "keyKey", "serverName"], "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string"}, "caKey": {"type": "string"}, "certKey": {"type": "string"}, "keyKey": {"type": "string"}, "serverName": {"type": "string"}}}, "sasl": {"type": "object", "additionalProperties": false, "required": ["mechanism", "secretName", "usernameKey", "passwordKey"], "properties": {"mechanism": {"enum": ["", "plain", "scram-sha-256", "scram-sha-512"]}, "secretName": {"type": "string"}, "usernameKey": {"type": "string"}, "passwordKey": {"type": "string"}}}}}
    }},
    "auth": {"type": "object", "additionalProperties": false, "required": ["mode", "internalTokenSecret"], "properties": {"mode": {"enum": ["anonymous", "basic", "bearer"]}, "existingSecret": {"type": "string"}, "usernameKey": {"type": "string"}, "passwordKey": {"type": "string"}, "bearerTokenKey": {"type": "string"}, "adminTokenKey": {"type": "string"}, "internalTokenSecret": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string"}, "key": {"type": "string"}}}}},
    "service": {"type": "object"}, "ingress": {"type": "object"}, "networkPolicy": {"type": "object"}, "podDisruptionBudget": {"type": "object"}, "resources": {"type": "object"},
    "podAnnotations": {"type": "object"}, "podLabels": {"type": "object"}, "podSecurityContext": {"type": "object"}, "securityContext": {"type": "object"}, "nodeSelector": {"type": "object"}, "tolerations": {"type": "array"}, "affinity": {"type": "object"}, "topologySpreadConstraints": {"type": "array"}, "priorityClassName": {"type": "string"}, "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {"if": {"properties": {"storage": {"properties": {"backend": {"const": "pvc"}}}}}, "then": {"properties": {"replicaCount": {"const": 1}}}},
    {"if": {"properties": {"storage": {"properties": {"backend": {"const": "kafka"}}}}}, "then": {"properties": {"replicaCount": {"minimum": 2}, "storage": {"properties": {"kafka": {"properties": {"brokers": {"minItems": 1}, "replicationFactor": {"minimum": 2}}}}}, "auth": {"properties": {"internalTokenSecret": {"properties": {"key": {"minLength": 1}}}}}}}}
  ]
}
