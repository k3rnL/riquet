  "clients": [
    {"name":"Confluent Java SerDes","version":"8.3.0","status":"supported","scenarios":["java-serdes-avro-protobuf-json-references"]},
    {"name":"franz-go Schema Registry client","version":"1.3.0","status":"supported","scenarios":["go-client-wire-envelope"]},
    {"name":"Confluent Python client","version":"2.12.2","status":"supported","scenarios":["python-avro-wire-envelope"]},
    {"name":"Confluent .NET client","version":"2.12.0","status":"supported","scenarios":["dotnet-avro-wire-envelope"]},
    {"name":"Confluent Kafka Connect AvroConverter","version":"8.3.0","status":"supported","scenarios":["kafka-connect-avro-converter"]}
