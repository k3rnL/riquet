  ],
  "exceptions": [
    {
      "id": "parser-diagnostic-wording",
      "versions": ["8.3.0"],
      "scenario": "errors-and-deletion:malformed registration",
      "rationale": "Riquet matches the HTTP status, numeric error code, response shape, and atomic behavior but emits bounded Go parser diagnostics instead of Confluent's Java exception text."
    }
