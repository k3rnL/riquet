      {"method":"DELETE","path":"/subjects/{subject}","status":"supported","scenarios":["avro-api","errors-and-deletion"]},
      {"method":"GET","path":"/config","status":"supported","scenarios":["avro-api"]},
      {"method":"PUT","path":"/config","status":"supported","scenarios":["avro-api"]},
      {"method":"GET","path":"/config/{subject}","status":"supported","scenarios":["avro-api"]},
      {"method":"PUT","path":"/config/{subject}","status":"supported","scenarios":["avro-api"]},
      {"method":"DELETE","path":"/config/{subject}","status":"supported","scenarios":["avro-api"]},
      {"method":"GET","path":"/mode","status":"supported","scenarios":["avro-api"]},
      {"method":"PUT","path":"/mode","status":"supported","scenarios":["avro-api"]},
      {"method":"GET","path":"/mode/{subject}","status":"supported","scenarios":["avro-api"]},
      {"method":"PUT","path":"/mode/{subject}","status":"supported","scenarios":["avro-api"]},
      {"method":"DELETE","path":"/mode/{subject}","status":"supported","scenarios":["avro-api"]},
      {"method":"POST","path":"/compatibility/subjects/{subject}/versions/{version}","status":"supported","scenarios":["avro-api","protobuf-api","json-api","avro-evolution","protobuf-evolution","json-evolution"]}
    ]
